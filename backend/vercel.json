{
  "version": 2,
  "builds": [
    {
      "src": "./index.js",
      "use": "@vercel/node"
    }
  ],
  "crons": [
    {
      "path": "/api/recurring-suggestions/detect",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/jobs/forex-revaluation",
      "schedule": "0 18 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}